<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Framework-level configuration for FlipSwitch. One record with DeveloperName = Default.</description>
    <fields>
        <fullName>Cache_Partition_Name__c</fullName>
        <defaultValue>&apos;local.FlipSwitch&apos;</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Cache Partition Name</label>
        <length>255</length>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Circuit_Breaker_Enabled__c</fullName>
        <defaultValue>true</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Circuit Breaker Enabled</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Log_Sampling_Rate__c</fullName>
        <defaultValue>100</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Log Sampling Rate (%)</label>
        <precision>3</precision>
        <scale>0</scale>
        <type>Number</type>
    </fields>
    <label>Feature Flag Config</label>
    <pluralLabel>Feature Flag Configs</pluralLabel>
</CustomObject>
