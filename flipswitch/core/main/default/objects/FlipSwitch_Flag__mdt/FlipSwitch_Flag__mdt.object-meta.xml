<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Defines feature flags for the FlipSwitch framework. Deploy via CI/CD; use FlipSwitch_Rule__c for runtime targeting rules.</description>
    <fields>
        <fullName>Category__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Category</label>
        <length>100</length>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Default_Value__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Default Value</label>
        <length>255</length>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Description</label>
        <length>32768</length>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Expiration_Date__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Expiration Date</label>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Capacity__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Inventory Capacity</label>
        <precision>18</precision>
        <scale>0</scale>
        <required>false</required>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>Is_Closed__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Closed</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Type</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Boolean</fullName>
                    <default>true</default>
                    <label>Boolean</label>
                </value>
                <value>
                    <fullName>Variant</fullName>
                    <default>false</default>
                    <label>Variant</label>
                </value>
                <value>
                    <fullName>Percentage</fullName>
                    <default>false</default>
                    <label>Percentage</label>
                </value>
                <value>
                    <fullName>Inventory</fullName>
                    <default>false</default>
                    <label>Inventory</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>FlipSwitch Flag</label>
    <pluralLabel>FlipSwitch Flags</pluralLabel>
</CustomObject>
