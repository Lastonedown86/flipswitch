<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Registers plugin classes that implement FeatureFlagPlugin. Each record activates one plugin.</description>
    <fields>
        <fullName>Class_Name__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Apex Class Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Is_Enabled__c</fullName>
        <defaultValue>true</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Enabled</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Priority__c</fullName>
        <defaultValue>10</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Priority</label>
        <precision>3</precision>
        <scale>0</scale>
        <type>Number</type>
    </fields>
    <label>Feature Flag Plugin</label>
    <pluralLabel>Feature Flag Plugins</pluralLabel>
</CustomObject>
